# Copy to .env and fill in. Never commit .env. On the server: chmod 600 .env
# All variables are validated at backend startup (apps/backend/src/config.ts); missing required values abort startup.

# ── General ──────────────────────────────────────────────────────────────────
# development | test | production
NODE_ENV=
# Public origin of the app, no trailing slash, e.g. https://app.example.com (used for CSRF Origin checks, WebAuthn origin, links)
APP_ORIGIN=
# Domain served by Caddy, e.g. app.example.com
APP_DOMAIN=
# Default IANA time zone for scheduling and display (user setting overrides after setup)
APP_TIMEZONE=Europe/Bratislava
# trace | debug | info | warn | error
LOG_LEVEL=info

# ── Backend ──────────────────────────────────────────────────────────────────
# Port the backend listens on inside the container/network
BACKEND_PORT=4000
# Comma-separated roles this process runs: api, worker
BACKEND_ROLES=api,worker
# CIDR(s) of the reverse proxy whose X-Forwarded-For is trusted (Docker network of Caddy)
TRUST_PROXY_CIDRS=

# ── Database ─────────────────────────────────────────────────────────────────
# Used by the postgres container
POSTGRES_DB=projectu
POSTGRES_USER=projectu
# Long random password (e.g. `openssl rand -base64 32`)
POSTGRES_PASSWORD=
# Connection string used by the backend, e.g. postgres://projectu:<password>@postgres:5432/projectu
DATABASE_URL=

# ── Auth (WebAuthn / passkeys) ───────────────────────────────────────────────
# Relying Party ID = registrable domain the passkeys are bound to, e.g. app.example.com
WEBAUTHN_RP_ID=
# Human-readable name shown in passkey prompts
WEBAUTHN_RP_NAME=Dashboard
# One-time token for registering the first passkey (`openssl rand -hex 32`). Remove after setup.
SETUP_TOKEN=

# ── Web Push (VAPID) ─────────────────────────────────────────────────────────
# Generate once: `node dist/cli.js vapid:generate` (backend). Rotating invalidates all subscriptions.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact for push services: mailto:<address> or https URL
VAPID_SUBJECT=

# ── Telegram ─────────────────────────────────────────────────────────────────
# From @BotFather
TELEGRAM_BOT_TOKEN=
# Secret sent by Telegram in X-Telegram-Bot-Api-Secret-Token (1-256 chars: A-Z a-z 0-9 _ -)
TELEGRAM_WEBHOOK_SECRET=
# Your numeric chat id; the only chat the bot answers (find via `node dist/cli.js telegram:whoami`)
TELEGRAM_ALLOWED_CHAT_ID=

# ── External data sources ────────────────────────────────────────────────────
# football-data.org API token (free registration)
FOOTBALL_DATA_API_TOKEN=
# Open-Meteo, Jolpica, OpenF1: no keys required

# ── Monitoring (optional) ────────────────────────────────────────────────────
# Healthchecks.io ping URL for the scheduler heartbeat; empty disables the heartbeat
HEALTHCHECKS_HEARTBEAT_URL=

# ── Reverse proxy ────────────────────────────────────────────────────────────
# E-mail for Let's Encrypt account (certificate expiry notices)
ACME_EMAIL=

# ── Backups (used by ops/backup.sh, not by the app) ──────────────────────────
# age public key (age1...) — the private key stays offline
AGE_RECIPIENT=
# rclone remote and path, e.g. b2-projectu:projectu-backups
RCLONE_DESTINATION=
# Healthchecks.io ping URL for the backup job; empty disables
HEALTHCHECKS_BACKUP_URL=
