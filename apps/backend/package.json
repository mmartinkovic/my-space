{
  "name": "@projectu/backend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=../../.env --watch src/main.ts",
    "start": "node src/main.ts",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=../../.env src/cli.ts db:migrate"
  },
  "dependencies": {
    "@fastify/type-provider-zod": "1.0.3",
    "@projectu/core-domain": "workspace:*",
    "@projectu/core-schemas": "workspace:*",
    "drizzle-orm": "0.45.4",
    "fastify": "5.12.8",
    "pg": "8.23.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@projectu/core-config": "workspace:*",
    "@types/node": "26.6.10",
    "@types/pg": "8.23.1",
    "drizzle-kit": "0.31.11"
  }
}
